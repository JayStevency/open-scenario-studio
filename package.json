{
  "name": "open-scenario-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @oss/web --filter @oss/api dev",
    "dev:web": "pnpm --filter @oss/web dev",
    "dev:api": "pnpm --filter @oss/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:migrate": "pnpm --filter @oss/api db:migrate",
    "db:seed": "pnpm --filter @oss/api db:seed",
    "db:reset": "pnpm --filter @oss/api db:reset",
    "mcp:smoke": "pnpm --filter @oss/mcp smoke"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
