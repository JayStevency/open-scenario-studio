// [잠정] REQUIREMENTS.md v0.1 초안 위에 미리 세운 안이다. 확정된 설계가 아니다.
//        마이그레이션을 돌리기 전이므로 얼마든지 바꿀 수 있다. CLAUDE.md '잠정' 절 참고.
//
// design/REQUIREMENTS.md 4절 데이터 모델.
// 모든 편집 대상 엔티티는 version 을 갖는다 — 갱신 시 버전이 어긋나면 409 로 막는다(NFR-03).

// Prisma 7: 접속 URL 은 prisma.config.ts 로, 런타임 연결은 드라이버 어댑터로 넘어갔다.
// 생성물은 저장소에 올리지 않는다. pnpm install 의 postinstall 이 만든다.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// SQLite 를 쓴다. 데이터가 23KB 수준이고 편집자가 소수라 서버 DB 가 필요 없다.
// 제약: 원시 타입 배열(String[])을 못 쓴다. enum 과 Json 은 쓸 수 있다.
datasource db {
  provider = "sqlite"
}

/// 프로젝트 단위로 데이터를 분리한다(요구사항 3절).
model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  scenarios    Scenario[]
  rules        Rule[]
  relations    ScenarioRelation[]
  links        RuleLink[]
  capabilities CapabilityGroup[]
  devScenarios DevScenario[]
  changes      ChangeLog[]
  memberships  Membership[]
  optionLists  OptionList[]
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String
  memberships Membership[]
  changes     ChangeLog[]
}

/// 사용자는 프로젝트별로 역할을 부여받는다(요구사항 3절).
enum Role {
  PLANNER // 기획자
  DEV_LEAD // 개발 리드
  REVIEWER // 검토자
  ADMIN // 관리자
}

model Membership {
  projectId String
  userId    String
  role      Role

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
}

/// 유형·담당 주체·상태 선택 목록은 관리자가 프로젝트별로 설정한다(FR-107).
model OptionList {
  id        String @id @default(cuid())
  projectId String
  kind      String // ruleType | owner | status | relationKind | linkKind | lifecycleStage
  /// 선택 값 목록. SQLite 가 배열을 못 담아 JSON 문자열로 둔다.
  values    Json   @default("[]")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
}

/// SC — 시나리오
model Scenario {
  id           String
  projectId    String
  name         String
  displayName  String
  area         String
  trigger      String?
  endCondition String?
  lifecycle    String?
  x            Float?
  y            Float?
  version      Int     @default(1)

  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rules        Rule[]
  outgoingRels ScenarioRelation[] @relation("relFrom")
  incomingRels ScenarioRelation[] @relation("relTo")

  // ID 는 프로젝트 안에서만 유일하다. 다른 프로젝트가 같은 SC-0 을 써도 부딪히지 않는다.
  @@id([projectId, id])
}

/// BR — 동작 규칙. 정확히 하나의 SC, 최대 하나의 CAP 에 속한다.
model Rule {
  id           String
  projectId    String
  scenarioId   String
  statement    String
  ruleType     String
  owner        String?
  capabilityId String?
  status       String
  openIssue    String?
  orderIndex   Int     @default(0)
  version      Int     @default(1)

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // SC 삭제 시 소속 BR 을 함께 지울지는 앱이 묻는다(4절) — DB 는 Restrict 로 사고를 막는다.
  scenario   Scenario         @relation(fields: [projectId, scenarioId], references: [projectId, id], onDelete: Restrict)
  // CAP 삭제 시 배정만 해제된다(FR-108). 복합 키에서는 SetNull 을 못 쓰므로
  // DB 가 아니라 앱이 먼저 해제한다 — 무엇이 함께 정리되는지 사용자에게 알려야 하기도 하다.
  capability CapabilityGroup? @relation(fields: [projectId, capabilityId], references: [projectId, id], onDelete: NoAction)

  // BR 삭제 시 참조하는 LINK 는 함께 지운다(4절).
  outgoingLinks RuleLink[]         @relation("linkFrom")
  incomingLinks RuleLink[]         @relation("linkTo")
  basisForRels  ScenarioRelation[] @relation("relBasis")

  @@id([projectId, id])
  @@index([projectId, scenarioId])
  @@index([projectId, capabilityId])
}

/// REL — 시나리오 간 관계
model ScenarioRelation {
  id          String
  projectId   String
  fromId      String
  toId        String
  kind        String // 전환 · 분기 · 재실행 · 준용
  condition   String?
  basisRuleId String?
  version     Int     @default(1)

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from      Scenario @relation("relFrom", fields: [projectId, fromId], references: [projectId, id], onDelete: Cascade)
  to        Scenario @relation("relTo", fields: [projectId, toId], references: [projectId, id], onDelete: NoAction)
  // 근거 규칙이 지워지면 지정만 풀린다(FR-108).
  basisRule Rule?    @relation("relBasis", fields: [projectId, basisRuleId], references: [projectId, id], onDelete: NoAction)

  @@id([projectId, id])
  @@index([projectId])
}

/// LINK — BR 간 관계. 같은 두 규칙 사이 같은 종류는 하나뿐이다(FR-405).
model RuleLink {
  id        String
  projectId String
  fromId    String
  toId      String
  kind      String // 선행 · 예외 · 대체 · 데이터 의존
  note      String?
  version   Int    @default(1)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  from    Rule    @relation("linkFrom", fields: [projectId, fromId], references: [projectId, id], onDelete: Cascade)
  to      Rule    @relation("linkTo", fields: [projectId, toId], references: [projectId, id], onDelete: NoAction)

  @@id([projectId, id])
  @@unique([projectId, fromId, toId, kind])
  @@index([projectId])
}

/// CAP — 기능 그룹. 정확히 하나의 DEV 에 속한다.
model CapabilityGroup {
  id           String
  projectId    String
  devId        String
  name         String
  description  String?
  version      Int    @default(1)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dev     DevScenario @relation(fields: [projectId, devId], references: [projectId, id], onDelete: Restrict)
  rules   Rule[]

  @@id([projectId, id])
  @@index([projectId, devId])
}

/// DEV — 개발 시나리오
model DevScenario {
  id                 String
  projectId          String
  name               String
  description        String?
  owner              String?
  /// 선행 개발 시나리오 ID 목록. SQLite 가 배열을 못 담아 JSON 문자열로 둔다.
  prerequisiteDevIds Json    @default("[]")
  acceptanceCriteria String?
  version            Int     @default(1)

  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capabilities CapabilityGroup[]

  @@id([projectId, id])
  @@index([projectId])
}

/// 누가 고쳤는가. 에이전트가 명세를 직접 수정하므로 사람과 구분해서 남긴다.
enum ActorType {
  USER
  AGENT
}

/// 변경 이력. append-only — 수정·삭제하지 않는다(FR-406, NFR-04).
model ChangeLog {
  // SQLite 의 자동 증가는 INTEGER 기본키에만 붙는다. BigInt 로 두면 id 가 비어 들어간다.
  id         Int       @id @default(autoincrement())
  projectId  String
  at         DateTime  @default(now())
  actorType  ActorType @default(USER)
  /// 에이전트가 고친 경우 어느 에이전트인지. 사람이면 null.
  actorLabel String?
  authorId   String?
  entityType String // Scenario | Rule | ScenarioRelation | RuleLink | CapabilityGroup | DevScenario
  entityId   String
  action     String // create | update | delete | note(FR-407 사용자 메모)
  /// 바뀐 필드의 변경 전 값. create 면 null.
  /// 되돌리기(NFR-04)는 이 값을 근거로 한다 — after 만으로는 원래 값을 알 수 없다.
  before     Json?
  /// 바뀐 필드의 변경 후 값. delete 면 null.
  after      Json?
  /// 사용자가 남긴 메모(FR-407). 자동 기록과 한 줄기로 본다.
  note       String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, at])
  @@index([projectId, entityType, entityId])
  @@index([projectId, actorType, at])
}
